rules_version = '2';

// Firestore security rules for ZenGM cloud multiplayer.
//
// HOW TO PUBLISH (do this once, before your ~30-day test-mode rules expire):
//   1. Firebase console -> your project
//   2. Build -> Firestore Database -> Rules tab
//   3. Replace everything with the contents of this file
//   4. Click "Publish"
//
// These rules do NOT expire.
//
// THE MODEL: THE ROOM CODE IS THE CAPABILITY.
//
// Anyone can sign in (the app signs in anonymously, with no account), so
// `request.auth != null` is not a wall - it is only what lets a rule say "this
// write is stamped with the uid that made it". What actually protects a league
// is that its data lives at a path nobody can reach without knowing the code.
//
// Which is why nothing here grants `list`. Firestore splits reading into `get`
// (one document, at a path you already know) and `list` (a query over a
// collection, which hands back documents you could not have named). The room
// registry used to allow both, so a signed-in stranger could enumerate every
// code in the project, read every league's full history, and delete any of it.
// `allow get` without `allow list` closes that: you can open the room you were
// invited to, and there is no query that discovers the rest.
//
// So pick a code that isn't easy to guess - it IS the shared secret for your
// league. The app generates one for you.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A write to a control doc must be stamped with the uid that made it, so a
    // change can never be attributed to someone else. Every writer in the app
    // stamps `holderId` for exactly this reason.
    function stampedByMe() {
      return request.resource.data.holderId == request.auth.uid;
    }

    // The version pointer is the whole protocol: one integer that every change
    // claims by compare-and-set. It only ever moves FORWARD - the client
    // refuses a commit whose base has moved, so a lower version can only come
    // from a device running stale code, a zombie writer that woke up late, or
    // someone editing the room by hand. Any of those rewinds the league for
    // everyone, so the rule refuses it outright rather than trusting the
    // client's own check.
    //
    // `>=`, not `>`, and that matters: on an update `request.resource.data` is
    // the document as it WILL BE, so a partial write that never mentions
    // `version` (committing a checkpoint stamps only the checkpoint fields)
    // compares the current version against itself. Tightening this to `>` would
    // refuse every checkpoint in the room.
    function versionNeverGoesBackwards() {
      return request.resource.data.version >= resource.data.version;
    }

    match /leagues/{code} {
      // `get` only, never `list` - see the note above. This document exists so
      // a device can probe the connection and read the room's league
      // fingerprint; it is not an index of anything.
      allow get: if signedIn();
      allow create, update: if signedIn();
      // Deleting the room document is how a league's cloud data is cleared, and
      // it takes the code to do it.
      allow delete: if signedIn();

      // Everything the room coordinates on: who is in charge of simming, the
      // ready-up gates, the free agency board, the live broadcast, the chat -
      // and the version chain itself (the `v2state` pointer plus the immutable
      // delta and checkpoint chunks it points at).
      match /control/{docId} {
        allow read: if signedIn();
        allow create: if signedIn() && stampedByMe();
        allow update: if signedIn()
                      && stampedByMe()
                      && (docId != 'v2state' || versionNeverGoesBackwards());
        // Housekeeping: superseded checkpoint generations, spent delta chunks,
        // and a finished broadcast's payload are cleaned up by whoever wrote
        // them next.
        allow delete: if signedIn();
      }

      // The legacy change log. Append-only while a room is live; deletes exist
      // so old history can be cleared out.
      match /changes/{changeId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn();
      }

      // Push-notification registrations: one document per device, keyed by its
      // uid, so a device can only ever write its own phone token.
      match /members/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // The notification queue the Cloud Function drains. Append-only, and you
      // can only enqueue notifications authored by your own account. (The
      // function reads these with the Admin SDK, which bypasses these rules.)
      match /notifications/{notificationId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn();
      }
    }
  }
}
