rules_version = '2';

// Firestore security rules for ZenGM cloud multiplayer.
//
// HOW TO PUBLISH (do this once, before your ~30-day test-mode rules expire):
//   1. Firebase console -> your project (zengmcloud-4a454)
//   2. Build -> Firestore Database -> Rules tab
//   3. Replace everything with the contents of this file
//   4. Click "Publish"
//
// What these rules enforce:
//   - You must be signed in (the app signs in anonymously automatically).
//   - The change log is append-only: you can add changes, but nobody can edit
//     or delete existing ones.
//   - You can only write a change authored by your own account (no spoofing
//     someone else's authorId).
//   - Access to a league room still requires knowing its code, so use a code
//     that isn't easy to guess (it's the shared secret for your league).
//   - Push notifications: each device may write only its own member entry (its
//     phone token), and the notification queue is append-only and can only be
//     written under your own account.
//
// These rules do NOT expire.

service cloud.firestore {
  match /databases/{database}/documents {

    // Room registry doc (leagues/{code}), so the admin page can LIST every code
    // that's been used. Any signed-in member may upsert it (on connect) and, for
    // cleanup, delete it.
    match /leagues/{code} {
      allow read, write: if request.auth != null;
    }

    match /leagues/{code}/changes/{changeId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;

      // The change log is append-only during play; deletes are allowed only so
      // the admin page can clear out old rooms.
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // The "sim authority": which single device is currently allowed to advance the
    // league (sim, draft, change phase). A room has exactly one such doc. Any
    // signed-in member may claim it, but only FOR THEMSELVES - you set holderId
    // to your own uid, never assign control to (or yank it from) someone else.
    // Everyone watches this doc to agree on who's in control.
    match /leagues/{code}/control/{docId} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.resource.data.holderId == request.auth.uid;

      // Deletes allowed only for admin room cleanup.
      allow delete: if request.auth != null;
    }

    // Push-notification registrations: one doc per device, keyed by its uid, so
    // each account can only write its own phone token - but any member may
    // delete entries for admin room cleanup.
    match /leagues/{code}/members/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null;
    }

    // The notification queue the Cloud Function drains. Append-only, and you can
    // only enqueue notifications authored by your own account. (The function
    // reads these via the Admin SDK, which bypasses these rules.)
    match /leagues/{code}/notifications/{notificationId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;

      allow update: if false;
      // Deletes allowed only for admin room cleanup.
      allow delete: if request.auth != null;
    }
  }
}
