rules_version = '2';

// Firestore security rules for ZenGM cloud multiplayer.
//
// HOW TO PUBLISH (do this once, before your ~30-day test-mode rules expire):
//   1. Firebase console -> your project (zengmcloud-4a454)
//   2. Build -> Firestore Database -> Rules tab
//   3. Replace everything with the contents of this file
//   4. Click "Publish"
//
// What these rules enforce:
//   - You must be signed in (the app signs in anonymously automatically).
//   - The change log is append-only: you can add changes, but nobody can edit
//     or delete existing ones.
//   - You can only write a change authored by your own account (no spoofing
//     someone else's authorId).
//   - Access to a league room still requires knowing its code, so use a code
//     that isn't easy to guess (it's the shared secret for your league).
//
// These rules do NOT expire.

service cloud.firestore {
  match /databases/{database}/documents {

    match /leagues/{code}/changes/{changeId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;

      // The change log is append-only.
      allow update, delete: if false;
    }
  }
}
